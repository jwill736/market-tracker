# Copy this file to .env and fill in what you use. Only SEC_USER_AGENT matters to start.

# Required by SEC EDGAR fair-access policy: identify yourself with a contact email.
# Used for the filing radar, insider trades and dilution checks.
SEC_USER_AGENT="plumbline you@example.com"

# Phone alerts (optional): install the ntfy app, subscribe to a long random topic name, put it here.
# Scary filings, loud news, pro mentions of your holdings and hot topics then reach your phone
# while the app is running.
NTFY_TOPIC=

# Optional: read-only Coinbase sync. coinbase.com/settings/api → create a key with the View
# permission only and the ECDSA algorithm; paste its name and private key (keep the \n line breaks).
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# Optional: Finnhub key (free at finnhub.io) for tick-by-tick US stock prices and company news.
FINNHUB_API_KEY=

# Claude deep-dive research (optional; any Anthropic credential source works).
ANTHROPIC_API_KEY=
# Model used for deep dives. Default: claude-opus-5
MT_RESEARCH_MODEL=claude-opus-5

# SQLite file for your portfolio, watchlist, plan log and heads-ups.
MT_DB_PATH=market_tracker.db

# Private app on a server: set a password to require a login. Not needed on your own computer.
APP_PASSWORD=
